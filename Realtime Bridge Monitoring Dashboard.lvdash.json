{
  "datasets": [
    {
      "name": "fea69a45",
      "displayName": "bridge_metrics",
      "queryLines": [
        "SELECT \n",
        "md.bridge_id, \n",
        "md.name, \n",
        "md.location, \n",
        "md.type,\n",
        "md.height,\n",
        "md.opened_year,\n",
        "md.length_m,\n",
        "md.main_span_m,\n",
        "window_start, \n",
        "window_end, \n",
        "avg_temp, \n",
        "max_vibration, \n",
        "max_tilt_angle \n",
        "FROM \n",
        "bridge_monitoring.`03_gold`.bridge_metrics bm join bridge_monitoring.`02_silver`.bridge_metadata md ON bm.bridge_id = md.bridge_id\n",
        "ORDER BY window_start DESC"
      ]
    }
  ],
